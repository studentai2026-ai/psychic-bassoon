from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.textinput import TextInput
from kivy.uix.button import Button
from kivy.uix.label import Label
from kivy.uix.scrollview import ScrollView
from kivy.core.window import Window
from kivy.utils import get_color_from_hex
import threading
import requests

# ⚠️ ضع مفتاح OpenRouter هنا
API_KEY = "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"
MODEL = "openrouter/free"

# لون الخلفية (أزرق داكن)
Window.clearcolor = get_color_from_hex('#0F172A')


class StudentAIApp(App):
    def build(self):
        # التصميم الرئيسي
        layout = BoxLayout(
            orientation='vertical',
            padding=20,
            spacing=15
        )
        
        # العنوان
        title = Label(
            text='🎓 المساعد الدراسي الذكي',
            size_hint_y=0.1,
            font_size='22sp',
            color=get_color_from_hex('#38BDF8'),
            bold=True
        )
        layout.add_widget(title)
        
        # منطقة النتيجة (قابلة للتمرير)
        scroll = ScrollView(size_hint_y=0.6)
        self.result = Label(
            text='مرحباً! اكتب سؤالك بالأسفل واضغط "اسأل"',
            text_size=(Window.width - 40, None),
            size_hint_y=None,
            color=get_color_from_hex('#E2E8F0'),
            font_size='16sp',
            halign='right',
            valign='top'
        )
        self.result.bind(
            texture_size=lambda instance, value: setattr(instance, 'height', value[1])
        )
        scroll.add_widget(self.result)
        layout.add_widget(scroll)
        
        # حقل الإدخال
        self.input = TextInput(
            hint_text='اكتب سؤالك هنا...',
            size_hint_y=0.12,
            multiline=False,
            font_size='16sp',
            background_color=get_color_from_hex('#1E293B'),
            foreground_color=get_color_from_hex('#E2E8F0')
        )
        layout.add_widget(self.input)
        
        # زر الإرسال
        btn = Button(
            text='اسأل 🚀',
            size_hint_y=0.12,
            font_size='18sp',
            background_color=get_color_from_hex('#2563EB'),
            background_normal=''
        )
        btn.bind(on_press=self.ask)
        layout.add_widget(btn)
        
        return layout
    
    def ask(self, instance):
        question = self.input.text.strip()
        if not question:
            return
        
        self.result.text = '🤖 جاري التفكير...'
        self.input.text = ''
        
        # نستخدم Thread حتى لا تتجمد الواجهة
        threading.Thread(
            target=self.get_answer,
            args=(question,),
            daemon=True
        ).start()
    
    def get_answer(self, question):
        try:
            url = "https://openrouter.ai/api/v1/chat/completions"
            headers = {
                "Authorization": f"Bearer {API_KEY}",
                "Content-Type": "application/json",
                "HTTP-Referer": "https://student-ai.app",
                "X-Title": "Student AI Assistant"
            }
            data = {
                "model": MODEL,
                "messages": [
                    {
                        "role": "system",
                        "content": "أنت مساعد دراسي ذكي للطلاب العرب. اشرح ببساطة وبالعربية."
                    },
                    {"role": "user", "content": question}
                ]
            }
            r = requests.post(url, headers=headers, json=data, timeout=60)
            
            if r.status_code != 200:
                self.result.text = f"❌ خطأ {r.status_code}\n{r.text[:200]}"
                return
            
            answer = r.json()["choices"][0]["message"]["content"]
            self.result.text = answer
        
        except requests.exceptions.Timeout:
            self.result.text = "❌ انتهت مهلة الاتصال. جرّب مرة أخرى."
        except requests.exceptions.ConnectionError:
            self.result.text = "❌ فشل الاتصال. تحقق من الإنترنت."
        except Exception as e:
            self.result.text = f"❌ خطأ: {e}"


if __name__ == '__main__':
    StudentAIApp().run()